rules_version = '2';

// アンケート・学習データ収集用のFirestoreセキュリティルール。
//
// このアプリはログイン機能（Firebase Authenticationなど）を持たないため、
// 「本当にこの参加者ID本人からの書き込みか」をサーバー側で検証する手段がない。
// そのため、なりすまし書き込み自体は防げない前提のうえで、次の最低限の方針にする。
//
// - 書き込み（作成）は許可する：参加者が自分の学習記録を送信できる必要があるため。
// - 読み取り・更新・削除はクライアントから一切禁止する：これにより、少なくとも
//   「他人の学習記録を読み取られる」ことは確実に防げる。データの確認は
//   Firebaseコンソール側で行う想定。
//
// 次回、HISTORY画面と匿名認証（Firebase Anonymous Authentication）を追加する際は、
// 読み取りだけでなく書き込みも匿名認証のUIDに紐づけて制限する方向に見直す予定
// （2026年時点の方針）。
service cloud.firestore {
  match /databases/{database}/documents {
    // participants/{participantId}/attempts/{attemptId}
    // 参加者ごとに、1問答えるたびの記録をサブコレクションとして保存する構造。
    match /participants/{participantId}/attempts/{attemptId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // 上記以外のパスは、念のためすべて拒否する（デフォルト拒否）。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
