rules_version = '2';

// アンケート・学習データ収集用のFirestoreセキュリティルール。
//
// Firebase Anonymous Authentication（画面には出ない、裏側だけの仕組み。
// AuthService参照）で発行されるUIDを、本人確認の代わりに使う。
// 各記録（`participants/{参加者ID}/attempts/{記録ID}`）には、書き込んだ
// 本人の匿名認証UIDを`ownerUid`フィールドとして必ず含める
// （LearningRecordService参照）。
//
// - 書き込み（作成）：送信しようとしているデータのownerUidが、リクエスト元
//   本人の匿名認証UIDと一致する場合のみ許可する（他人になりすまして
//   書き込むことはできない）。
// - 読み取り：既存の記録のownerUidが、リクエスト元本人の匿名認証UIDと
//   一致する場合のみ許可する（＝自分の記録だけ読み取れる。他人の記録は
//   読み取れない）。
// - 更新・削除は許可しない（記録は一度書き込んだら変更しない前提のため）。
//
// 2026年時点の方針（変更履歴）：当初はログイン機能を一切持たず、書き込みのみ
// 許可・読み取りは全面禁止としていたが、匿名認証の導入にあわせて、書き込み・
// 読み取りの両方をownerUidに紐づけて制限する方式に変更した。
service cloud.firestore {
  match /databases/{database}/documents {
    match /participants/{participantId}/attempts/{attemptId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // 上記以外のパスは、念のためすべて拒否する（デフォルト拒否）。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
